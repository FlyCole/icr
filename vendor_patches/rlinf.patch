+def _video_scores(*, starts, previous, progress, valid=None, done=None, chunk=1):
+    count = len(starts)
+    valid = [True] * count if valid is None else valid
+    return {
+        "valid": torch.tensor(valid),
+        "episode_start": torch.tensor(starts),
+        "previous_progress": torch.tensor(previous),
+        "progress": torch.tensor(progress),
+        "delta": torch.tensor(progress) - torch.tensor(previous),
+        "reward": 2 * (torch.tensor(progress) - torch.tensor(previous)),
+        "done": torch.tensor([False] * count if done is None else done),
+        "chunk_index": torch.tensor([chunk if item else 0 for item in valid]),
+        "env_id": torch.arange(100, 100 + count),
+    }
+
