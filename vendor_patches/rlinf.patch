+def _terminal_padding_trajectory(native_boundaries=True, offset=0.0):
+    ids = torch.arange(16, dtype=torch.float32).reshape(8, 2, 1) + offset
+    rewards = torch.zeros(8, 2, 2)
+    post_done = torch.zeros(2, 4, 2, 2, dtype=torch.bool)
+    for epoch, env, first_done in [(0, 0, 1), (0, 1, 3), (1, 0, 0), (1, 1, 2)]:
+        post_done[epoch, first_done:, env, -1] = True
+        rewards[epoch * 4 + first_done, env, -1] = 1.0
+    if native_boundaries:
+        flags = torch.cat([torch.zeros_like(post_done[:, :1]), post_done], dim=1)
+        flags = flags.reshape(10, 2, 2)
+    else:
+        flags = post_done.reshape(8, 2, 2)
+    return Trajectory(
+        max_episode_length=8,
+        actions=ids,
+        rewards=rewards,
+        dones=flags,
+        terminations=flags.clone(),
+        truncations=torch.zeros_like(flags),
+        curr_obs={"states": ids + 1000},
+        next_obs={"states": ids + 2000},
+        forward_inputs={"action": ids.clone(), "model_action": ids + 0.5},
+    )
+
+
+def _assert_terminal_padding_sample(batch, offsets=(0.0,)):
+    expected = {
+        index + offset
+        for offset in offsets
+        for index in [0, 1, 2, 3, 5, 7, 8, 9, 11, 13]
+    }
+    actions = batch["actions"].reshape(-1)
+    assert set(actions.tolist()) == expected
+    torch.testing.assert_close(batch["curr_obs"]["states"], batch["actions"] + 1000)
+    torch.testing.assert_close(batch["next_obs"]["states"], batch["actions"] + 2000)
+    torch.testing.assert_close(batch["forward_inputs"]["action"], batch["actions"])
+    successful_ids = torch.tensor(
+        [index + offset for offset in offsets for index in [2, 7, 8, 13]]
+    )
+    torch.testing.assert_close(
+        batch["rewards"].sum(-1), torch.isin(actions, successful_ids).float()
+    )
+
+
