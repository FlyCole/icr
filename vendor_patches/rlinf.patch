+    worker._stacklevel = 1
+    worker.use_dsrl = use_dsrl
+    worker.update_step = 0
+    worker.cfg = OmegaConf.create({"algorithm": {"tau": 0.005}})
+    worker.model = nn.Linear(1, 1, bias=False, dtype=torch.bfloat16)
+    worker.target_model = nn.Linear(1, 1, bias=False, dtype=torch.bfloat16)
+    for model in (worker.model, worker.target_model):
