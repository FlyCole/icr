+def test_record_video_preserves_pixels_and_labels_causal_chunk_endpoints(
+    tmp_path, monkeypatch
+):
+    env, recorder, written = _record_video_with_memory_encoder(
+        tmp_path, monkeypatch, num_envs=2
+    )
+    initial, _ = recorder.reset()
+    observations = [env.observation(value) for value in (20, 30, 40)]
+    snapshot = [obs["main_images"].copy() for obs in [initial, *observations]]
+    zeros = torch.zeros(2, 3)
+    env.results.append((observations, zeros, zeros.bool(), zeros.bool(), [{}, {}, {}]))
+    recorder.chunk_step(None)
+    recorder.annotate_reward(
+        _video_scores(starts=[True, True], previous=[0.1, 0.2], progress=[0.4, 0.6])
+    )
+    recorder.flush_video()
+
+    trace = json.loads((tmp_path / "seed_123/0.json").read_text())
+    assert len(written) == trace["frame_count"] == 4
+    assert [score["env_id"] for score in trace["scores"]] == [100, 101]
+    assert [score["reset_frame_index"] for score in trace["scores"]] == [0, 0]
+    assert [score["endpoint_frame_index"] for score in trace["scores"]] == [3, 3]
+    assert trace["scores"][0]["progress"] == pytest.approx(0.4)
+    assert trace["scores"][0]["reward"] == pytest.approx(0.6)
+    for obs, before in zip([initial, *observations], snapshot, strict=True):
+        np.testing.assert_array_equal(obs["main_images"], before)
+    for frame, value in zip(written, (10, 20, 30, 40), strict=True):
+        assert np.all(frame[:32] == value)
+    # Intermediate frames retain the same previous score; the endpoint changes it.
+    np.testing.assert_array_equal(written[1][32:], written[2][32:])
+    assert not np.array_equal(written[2][32:], written[3][32:])
+    recorder._executor.shutdown(wait=True)
