+        for epoch in range(4):
+            for rank in (0, 1):
+                success = int((step * 8 + epoch * 2 + rank) % 3 != 0)
+                expected.append(success)
+                shards[rank].append([step, epoch, 0, 0, 0, success])
+        metrics = window.update(
+            [
+                (rank, {TRAIN_EPISODE_OUTCOMES_KEY: torch.tensor(shards[rank])})
+                for rank in (1, 0)
+            ]
+        )
+        last100 = expected[-100:]
+        assert metrics == {
+            "success_rate_ma100": pytest.approx(sum(last100) / len(last100)),
+            "success_rate_ma100_count": len(last100),
+        }
+    assert len(expected) == 104
+    assert metrics["success_rate_ma100_count"] == 100
