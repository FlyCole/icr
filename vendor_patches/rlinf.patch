+def test_openpi_dsrl_head_precision_and_legacy_checkpoint(
+    head_precision, expected_dtype
+):
+    from rlinf.models.embodiment.openpi.pi0_config import Pi0Config
+    from rlinf.models.embodiment.openpi.tasks.dsrl import Pi0DSRL, Pi0DSRLConfig
+
+    options = {} if head_precision is None else {"head_precision": head_precision}
+    with torch.device("meta"):
+        model = Pi0DSRL(
+            Pi0Config(
+                dtype="bfloat16",
+                pi05=True,
+                paligemma_variant="dummy",
+                action_expert_variant="dummy",
+                action_horizon=2,
+                max_token_len=4,
+            ),
+            dsrl_cfg=Pi0DSRLConfig(state_dim=14, num_q_heads=2, **options),
+        )
+    model.to_bfloat16_for_selected_params("bfloat16")
+    model.freeze_vlm(freeze_action_expert=True)
+    head_names = (
+        "dsrl_action_noise_net",
+        "actor_image_encoder",
+        "actor_state_encoder",
+        "critic_image_encoder",
+        "critic_state_encoder",
+        "q_head",
+    )
+    for name in head_names:
+        head = getattr(model, name)
+        assert all(parameter.dtype == expected_dtype for parameter in head.parameters())
+        head.to_empty(device="cpu")
+        # Existing checkpoint tensors keep their shapes and cast on load.
+        legacy = {
+            key: torch.full(value.shape, 0.03125, dtype=torch.bfloat16)
+            for key, value in head.state_dict().items()
+        }
+        head.load_state_dict(legacy, strict=True)
+        for parameter in head.parameters():
+            assert parameter.requires_grad
+            assert parameter.dtype == expected_dtype
+            torch.testing.assert_close(parameter, torch.full_like(parameter, 0.03125))
+
+    decoder = [
+        parameter
+        for name, parameter in model.named_parameters()
+        if not name.startswith(tuple(prefix + "." for prefix in head_names))
+    ]
+    assert all(parameter.device.type == "meta" for parameter in decoder)
+    assert not any(parameter.requires_grad for parameter in decoder)
+    assert model.llm.layers[0].attn.q_proj[0].weight.dtype == torch.bfloat16
+    assert model.action_out_proj.weight.dtype == torch.float32
+
+    obs = {
+        "main_images": torch.zeros(1, 64, 64, 3, dtype=torch.uint8),
+        "states": torch.full((1, 14), 1.0001, dtype=torch.float32),
+    }
+    received_states = []
+    handle = model.actor_state_encoder.register_forward_pre_hook(
+        lambda module, inputs: received_states.append(inputs[0].clone())
+    )
+    with torch.no_grad():
+        actions, _, _ = model.sac_forward(obs=obs, mode="eval")
+        values = model.sac_q_forward(obs=obs, actions=actions)
+    handle.remove()
+    assert actions.dtype == values.dtype == expected_dtype
+    assert actions.shape == (1, 2, 32)
+    assert torch.isfinite(actions).all() and torch.isfinite(values).all()
+    torch.testing.assert_close(received_states[0], obs["states"].to(expected_dtype))
+    if head_precision == "fp32":
+        assert torch.equal(received_states[0], obs["states"])
+
