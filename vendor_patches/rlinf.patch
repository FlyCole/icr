+    """Return one scalar per replay transition from its per-action rewards.
+
+    ``first`` preserves the LIBERO DSRL reward convention. ``sum`` accepts
+    per-action rewards or a chunk reward stored in exactly one action slot.
+    """
+    if rewards.ndim != 2 or rewards.shape[-1] == 0:
+        raise ValueError(
+            f"DSRL rewards must have shape [batch, chunk_steps], got {tuple(rewards.shape)}"
+        )
+    if aggregation == "first":
+        return rewards[:, :1]
+    if aggregation == "sum":
+        return rewards.sum(dim=-1, keepdim=True)
+    raise ValueError(
