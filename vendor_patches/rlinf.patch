+def training_video_options(
+    video_cfg: DictConfig,
+    runner_cfg: DictConfig,
+    *,
+    rank: int,
+    world_size: int,
+    stage_id: int,
+    stage_num: int,
+    rollout_epoch: int,
+    default_max_videos: int = -1,
+) -> dict[str, int | None]:
+    """Divide a run-wide MP4 budget across environment recorders.
+
+    The user configuration keeps the global budget. Each wrapper receives a
+    local quota and the planned number of flushes for evenly spaced recording.
+    """
+    maximum = video_cfg.get("max_videos", default_max_videos)
+    if type(maximum) is not int or maximum < -1:
+        raise ValueError("video_cfg.max_videos must be an integer >= -1")
+    if (
+        world_size < 1
+        or stage_num < 1
+        or not 0 <= rank < world_size
+        or not 0 <= stage_id < stage_num
+        or rollout_epoch < 1
+    ):
+        raise ValueError("Expected valid environment ranks, stages and rollout_epoch")
+    count = world_size * stage_num
+    index = rank * stage_num + stage_id
+    local_maximum = (
+        -1 if maximum == -1 else maximum // count + int(index < maximum % count)
+    )
+    budgets = [
+        int(value)
+        for value in (runner_cfg.get("max_epochs", -1), runner_cfg.get("max_steps", -1))
+        if value is not None and int(value) >= 0
+    ]
+    slots = min(budgets) * rollout_epoch if budgets else None
+    return {"max_videos": local_maximum, "recording_slots": slots}
+
