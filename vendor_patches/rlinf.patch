+def _record_video_with_memory_encoder(tmp_path, monkeypatch, num_envs=1):
+    import imageio
+
+    from rlinf.envs.wrappers.record_video import RecordVideo
+
+    written = []
+
+    class Writer:
+        def append_data(self, frame):
+            written.append(frame.copy())
+
+        def close(self):
+            pass
+
+    monkeypatch.setattr(imageio, "get_writer", lambda *_args, **_kwargs: Writer())
+    env = _RewardVideoEnv(num_envs)
+    recorder = RecordVideo(
+        env,
+        OmegaConf.create(
+            {"video_base_dir": str(tmp_path), "info_on_video": False, "fps": 10}
+        ),
+    )
+    return env, recorder, written
+
