+def terminal_padding_sample_indices(
+    trajectory: Trajectory, chunks_per_rollout_epoch: int
+) -> torch.Tensor:
+    """Return flattened chunk indices up to and including each epoch's first done.
+
+    Native trajectories include a pre-action done boundary per rollout epoch.
+    Archived replay may omit those boundaries; its epoch length must be supplied
+    explicitly. Environments must reset between epochs and never auto-reset
+    within an epoch.
+    """
+    if chunks_per_rollout_epoch <= 0:
+        raise ValueError("chunks_per_rollout_epoch must be positive")
+    rewards = trajectory.rewards
+    if rewards is None or rewards.ndim < 2:
+        raise ValueError(
+            "Terminal-padding filtering requires rewards shaped [T, B, ...]"
+        )
+    time_steps, batch_size = rewards.shape[:2]
+    dones = trajectory.dones
+    if dones is None:
+        raise ValueError("Terminal-padding filtering requires trajectory.dones")
+    if dones.ndim < 2 or dones.shape[1] != batch_size:
+        raise ValueError("Trajectory dones must match the rewards' batch dimension")
+    extra_boundaries = dones.shape[0] - time_steps
+    if extra_boundaries < 0:
+        raise ValueError("Trajectory dones cannot be shorter than rewards")
+    dones = dones.reshape(dones.shape[0], batch_size, -1).any(dim=-1)
+    if extra_boundaries:
+        if time_steps % extra_boundaries:
+            raise ValueError("Epoch-start done boundaries do not evenly divide rewards")
+        epoch_length = time_steps // extra_boundaries
+        if epoch_length != chunks_per_rollout_epoch:
+            raise ValueError(
+                "Epoch-start done boundaries disagree with chunks_per_rollout_epoch"
+            )
+        boundaries = dones.reshape(extra_boundaries, epoch_length + 1, batch_size)
+        initial_done = boundaries[:, :1]
+        post_done = boundaries[:, 1:]
+    else:
+        if time_steps % chunks_per_rollout_epoch:
+            raise ValueError("Trajectory chunks do not evenly divide rollout epochs")
+        epoch_length = chunks_per_rollout_epoch
+        post_done = dones.reshape(-1, epoch_length, batch_size)
+        initial_done = torch.zeros_like(post_done[:, :1])
+
+    preceding_done = torch.cat([initial_done, post_done[:, :-1]], dim=1)
+    valid = preceding_done.to(torch.int64).cumsum(dim=1) == 0
+    return valid.reshape(-1).nonzero(as_tuple=True)[0].cpu()
+
