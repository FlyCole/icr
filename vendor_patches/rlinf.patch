+        )
+    with torch.no_grad():
+        worker.model.weight.fill_(0.5)
+        worker.target_model.weight.fill_(0.25)
+    worker.target_model_initialized = True
+    worker.target_update_type = "all"
+    if use_dsrl:
+        worker._init_target_shadow()
