+class _ScalarSACPolicy(nn.Module):
+    """CPU policy with an analytic actor gradient through its trainable Q head."""
+
+    def __init__(self):
+        super().__init__()
+        self.actor = nn.Parameter(torch.tensor(2.0))
+        self.critic = nn.Parameter(torch.tensor(5.0))
+        self.clip_inputs = []
+
+    def forward(self, forward_type, obs, actions=None, **kwargs):
+        batch_size = obs["states"].shape[0]
+        if forward_type == ForwardType.SAC:
+            pi = self.actor.expand(batch_size, 1)
+            return pi, pi * 0, None
+        if forward_type == ForwardType.SAC_Q:
+            return self.critic * actions.reshape(batch_size, -1)[:, :1]
+        raise NotImplementedError(forward_type)
+
+    def clip_grad_norm_(self, max_norm):
+        self.clip_inputs.append(
+            {
+                name: None if param.grad is None else param.grad.detach().clone()
+                for name, param in self.named_parameters()
+            }
+        )
+        return torch.nn.utils.clip_grad_norm_(self.parameters(), max_norm)
+
+
