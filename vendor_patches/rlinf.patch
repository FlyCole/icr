+class CompletedEpisodeSuccessTracker:
+    """Collect one success outcome per completed training episode.
+
+    Rows contain collection step, epoch, chunk, stage, environment slot, and
+    success. Non-resetting environments count their first done only; each
+    explicit epoch reset starts new episodes. Auto-resetting environments can
+    complete another episode on a later chunk.
+    """
+
+    def __init__(self, *, auto_reset: bool) -> None:
+        self.auto_reset = auto_reset
+        self._completed: dict[int, torch.Tensor] = {}
+        self._outcomes: list[list[int]] = []
+
+    def start_epoch(self) -> None:
+        if not self.auto_reset:
+            self._completed.clear()
+
+    def record(
+        self,
+        dones: torch.Tensor,
+        env_infos: dict | None,
+        *,
+        step: int,
+        epoch: int,
+        chunk: int,
+        stage: int,
+    ) -> None:
+        done = dones.detach().cpu().bool()
+        done = done.reshape(done.shape[0], -1).any(dim=1)
+        completed = self._completed.setdefault(stage, torch.zeros_like(done))
+        newly_done = done if self.auto_reset else done & ~completed
+        completed.logical_or_(done)
+        if not newly_done.any():
+            return
+
+        infos = env_infos or {}
+        if self.auto_reset:
+            infos = infos.get("final_info", {})
+        success = infos.get("episode", {}).get("success_once")
+        if success is None:
+            return
+        success = torch.as_tensor(success).detach().cpu().reshape(-1)
+        ended_slots = done.nonzero(as_tuple=True)[0]
+        if success.numel() == done.numel():
+            success = success[ended_slots]
+        elif success.numel() != ended_slots.numel():
+            raise ValueError(
+                "Completed episode success must have one value per environment "
+                f"or done slot; got {success.numel()} values for "
+                f"{done.numel()} environments and {ended_slots.numel()} done slots"
+            )
+        if (
+            not torch.isfinite(success).all()
+            or not ((success == 0) | (success == 1)).all()
+        ):
+            raise ValueError(
+                "Completed episode success values must be finite zero or one"
+            )
+        for slot, value in zip(ended_slots.tolist(), success.tolist()):
+            if newly_done[slot]:
+                self._outcomes.append([step, epoch, chunk, stage, slot, int(value)])
+
+    def as_tensor(self) -> torch.Tensor:
+        return torch.tensor(self._outcomes, dtype=torch.int64).reshape(-1, 6)
+
+
+class RollingEpisodeSuccessRate:
+    """Success mean over the latest completed episodes across environment ranks.
+
+    Each driver update orders parallel events by collection step, epoch, chunk,
+    stage, rank, and slot. Async updates include only events already received.
+    Warm-up uses available episodes and logs their count. State is driver-local
+    and resets on resume.
+    """
+
+    def __init__(self, window_size: int = 100) -> None:
+        if window_size < 1:
+            raise ValueError("Episode success window size must be positive")
+        self.window_size = window_size
+        self._successes: deque[int] = deque(maxlen=window_size)
+
+    def update(
+        self, worker_metrics: Sequence[tuple[int, dict | None]]
+    ) -> dict[str, float | int]:
+        events = []
+        for rank, metrics in worker_metrics:
+            if metrics is None:
+                continue
+            values = metrics.get(
+                TRAIN_EPISODE_OUTCOMES_KEY,
+                metrics.get(f"env/{TRAIN_EPISODE_OUTCOMES_KEY}"),
+            )
+            if values is None:
+                continue
+            rows = torch.as_tensor(values).detach().cpu()
+            if rows.ndim != 2 or rows.shape[1] != 6:
+                raise ValueError(
+                    "Completed episode outcomes must have shape [episodes, 6]"
+                )
+            for step, epoch, chunk, stage, slot, success in rows.tolist():
+                if success not in (0, 1):
+                    raise ValueError("Completed episode success must be zero or one")
+                events.append(((step, epoch, chunk, stage, rank, slot), int(success)))
+        self._successes.extend(success for _, success in sorted(events))
+        if not self._successes:
+            return {}
+        return {
+            f"success_rate_ma{self.window_size}": sum(self._successes)
+            / len(self._successes),
+            f"success_rate_ma{self.window_size}_count": len(self._successes),
+        }
