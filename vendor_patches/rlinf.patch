+"""Episode boundaries and valid-transition metadata for external rewards."""
+
+from typing import Any
+
+import torch
+
+from rlinf.utils.nested_dict_process import clone_nested_to_cpu
+
+
+def build_reward_chunk_metadata(
+    observations: Any,
+    *,
+    valid_action_mask: Any = None,
+    final_observation: dict[str, Any] | None = None,
+    dones: Any = None,
+    env_infos: dict[str, Any] | None = None,
+    image_key: str = "main_images",
+) -> dict[str, torch.Tensor]:
+    """Snapshot post-action images and native outcomes for a causal reward prefix.
+
+    Full-render chunks retain every action frame and exclude padded actions with
+    ``valid_action_mask``. Endpoint-only observations use one frame whose validity
+    means that at least one action was executed. Auto-reset images are replaced
+    with true terminal observations before either payload reaches the model.
+    """
+    items = observations if isinstance(observations, (list, tuple)) else [observations]
+    indices = [index for index, item in enumerate(items) if item is not None]
+    if not indices:
+        raise ValueError("Reward chunks require at least one post-action observation")
+    frames = []
+    for index in indices:
+        item = items[index]
+        if not isinstance(item, dict) or image_key not in item:
+            raise ValueError(
+                f"Reward observation {index} requires image key {image_key!r}"
+            )
+        image = torch.as_tensor(item[image_key]).detach().cpu().clone()
+        if image.ndim != 4 or image.shape[-1] != 3 or image.dtype != torch.uint8:
+            raise ValueError(
+                f"Reward images must be uint8 [B,H,W,3], got {image.dtype} {image.shape}"
+            )
+        frames.append(image)
+    batch_size = frames[0].shape[0]
+    if any(frame.shape != frames[0].shape for frame in frames):
+        raise ValueError("Reward chunk image shapes must agree across action frames")
+    done_mask = torch.zeros(batch_size, dtype=torch.bool)
+    if dones is not None:
+        done_mask = torch.as_tensor(dones).detach().cpu().bool()
+        done_mask = done_mask.reshape(batch_size, -1).any(dim=1)
+    if valid_action_mask is None:
+        mask = torch.ones(batch_size, len(indices), dtype=torch.bool)
+    else:
+        mask = torch.as_tensor(valid_action_mask).detach().cpu().bool().clone()
+        if mask.ndim != 2 or mask.shape[0] != batch_size:
+            raise ValueError("Reward action validity must have shape [B,chunk_size]")
+        if mask.shape[1] == len(items):
+            mask = mask[:, indices]
+        elif len(items) == 1:
+            mask = mask.any(dim=1, keepdim=True)
+        else:
+            raise ValueError(
+                "Reward action validity must match full-render observation count"
+            )
+    if final_observation is not None and done_mask.any():
+        terminal_image = torch.as_tensor(final_observation[image_key]).detach().cpu()
+        if terminal_image.shape != frames[-1].shape:
+            raise ValueError("Terminal reward images must match the observation batch")
+        for env_index in done_mask.nonzero(as_tuple=True)[0].tolist():
+            valid_indices = mask[env_index].nonzero(as_tuple=True)[0]
+            if valid_indices.numel():
+                frames[int(valid_indices[-1])][env_index] = terminal_image[env_index]
+    metadata = {
+        "reward_observation_frames": torch.stack(frames, dim=1),
+        "reward_frame_mask": mask,
+    }
+    success = torch.zeros(batch_size, dtype=torch.bool)
+    all_success_known = True
+    for env_index in range(batch_size):
+        info = env_infos
+        if (
+            done_mask[env_index]
+            and isinstance(env_infos, dict)
+            and isinstance(env_infos.get("final_info"), dict)
+        ):
+            info = env_infos["final_info"]
+        value = info.get("success") if isinstance(info, dict) else None
+        if value is None and isinstance(info, dict):
+            episode = info.get("episode")
+            if isinstance(episode, dict):
+                value = episode.get("success_once")
+        if value is None:
+            all_success_known = False
+            break
+        value = torch.as_tensor(value).detach().cpu().bool().reshape(-1)
+        if value.numel() not in (1, batch_size):
+            raise ValueError(
+                "Simulator success must be scalar or have one value per env"
+            )
+        success[env_index] = value[0 if value.numel() == 1 else env_index]
+    if all_success_known:
+        metadata["reward_simulator_success"] = success
+    return metadata
+
+
+class RewardEpisodeContext:
+    """Track reset boundaries independently for each vector-environment slot."""
+
+    def __init__(self, num_envs: int, first_env_id: int = 0) -> None:
+        if num_envs < 1 or first_env_id < 0:
+            raise ValueError("num_envs must be positive and first_env_id nonnegative")
+        self.num_envs = num_envs
+        self.env_ids = torch.arange(first_env_id, first_env_id + num_envs)
+        self.episode_start = torch.ones(num_envs, dtype=torch.bool)
+        self.active = torch.ones(num_envs, dtype=torch.bool)
+
+    def reset(self) -> None:
+        """Mark an actual reset of all environment slots."""
+        self.episode_start.fill_(True)
+        self.active.fill_(True)
+
+    def build(self, initial_observation: dict[str, Any]) -> dict[str, Any]:
+        """Snapshot the pre-action frame before simulator-owned buffers change."""
+        return {
+            "reward_env_id": self.env_ids.clone(),
+            "reward_episode_start": self.episode_start.clone(),
+            "reward_valid": self.active.clone(),
+            "reward_initial_observation": clone_nested_to_cpu(initial_observation),
+        }
+
+    def advance(self, dones: torch.Tensor, *, auto_reset: bool) -> None:
+        """Retain terminal transitions and suppress later padding until reset."""
+        dones = dones.detach().to(device="cpu", dtype=torch.bool)
+        if dones.ndim > 1:
+            dones = dones.reshape(dones.shape[0], -1).any(dim=1)
+        if dones.shape != (self.num_envs,):
+            raise ValueError(
+                f"Expected dones shape ({self.num_envs},), got {dones.shape}"
+            )
+        if auto_reset:
+            self.episode_start.copy_(dones)
+            self.active.fill_(True)
+        else:
+            self.episode_start.zero_()
+            self.active.logical_and_(~dones)
