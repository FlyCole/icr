+class _RewardVideoEnv:
+    """Small observation source at the simulator boundary of RecordVideo."""
+
+    seed = 123
+
+    def __init__(self, num_envs=1):
+        self.num_envs = num_envs
+        self.results = []
+
+    def observation(self, value):
+        return {
+            "main_images": np.full((self.num_envs, 32, 256, 3), value, dtype=np.uint8)
+        }
+
+    def reset(self):
+        return self.observation(10), {}
+
+    def chunk_step(self, _actions):
+        return self.results.pop(0)
