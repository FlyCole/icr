diff --git a/robometer/evals/context_demo.py b/robometer/evals/context_demo.py
new file mode 100644
index 0000000000000000000000000000000000000000..0072bfddd6787a32ced93484c13790fa44c84ebb
--- /dev/null
+++ b/robometer/evals/context_demo.py
@@ -0,0 +1,159 @@
+"""A validated, fixed successful RoboTwin reference for ICON requests.
+
+This module deliberately avoids the model stack so the artifact and checkpoint
+contract can be checked on CPU before loading model weights.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+
+def _field(section: Any, name: str, default: Any = None) -> Any:
+    return section.get(name, default) if isinstance(section, dict) else getattr(section, name, default)
+
+
+def conditioning_info(config: Any) -> dict[str, Any]:
+    data = _field(config, "data")
+    model = _field(config, "model")
+    return {
+        "conditioning_mode": _field(data, "conditioning_mode", "language"),
+        "context_frames": _field(data, "context_frames"),
+        "add_context_progress_tokens": _field(data, "add_context_progress_tokens", False),
+        "use_multi_image": _field(data, "use_multi_image", False),
+        "use_per_frame_progress_token": _field(data, "use_per_frame_progress_token", False),
+        "include_language_with_context": _field(data, "include_language_with_context", False),
+        "language_condition_dropout_prob": _field(data, "language_condition_dropout_prob", 0.0),
+        "context_condition_dropout_prob": _field(data, "context_condition_dropout_prob", 0.0),
+        "base_model_id": _field(model, "base_model_id"),
+    }
+
+
+def validate_icon_conditioning(config: Any) -> int:
+    """Reject settings that would drop or misinterpret the fixed demonstration."""
+    info = conditioning_info(config)
+    if info["conditioning_mode"] != "language_context":
+        raise ValueError("A fixed ICON demo requires conditioning_mode='language_context'")
+    for key in ("use_multi_image", "use_per_frame_progress_token", "add_context_progress_tokens"):
+        if info[key] is not True:
+            raise ValueError(f"A fixed ICON demo requires data.{key}=true")
+    model = _field(config, "model")
+    for key in ("use_multi_image", "use_per_frame_progress_token"):
+        if _field(model, key) is not True:
+            raise ValueError(f"A fixed ICON demo requires matching model.{key}=true")
+    if not 0 <= info["context_condition_dropout_prob"] < 1:
+        raise ValueError("Fixed ICON context must remain enabled during inference")
+    count = info["context_frames"]
+    if type(count) is not int or count < 1:
+        raise ValueError("Checkpoint context_frames must be a positive integer")
+    return count
+
+
+def evenly_spaced_context_indices(frame_count: int, context_frames: int) -> list[int]:
+    """Match full_training's deterministic nearest-rounded endpoint sampling."""
+    if frame_count < 1 or context_frames < 1:
+        raise ValueError("Frame counts must be positive")
+    if context_frames == 1:
+        return [0]
+    return [
+        (index * (frame_count - 1) + (context_frames - 1) // 2) // (context_frames - 1)
+        for index in range(context_frames)
+    ]
+
+
+@dataclass(frozen=True)
+class FixedContextDemo:
+    frames: np.ndarray
+    metadata: dict[str, Any]
+    path: str
+    metadata_sha256: str
+    selected_indices: list[int]
+
+    @classmethod
+    def load(cls, context_demo_path: str, config: Any) -> FixedContextDemo:
+        count = validate_icon_conditioning(config)
+        requested = Path(context_demo_path).expanduser().resolve()
+        frames_path = requested / "frames.npy" if requested.is_dir() else requested
+        metadata_path = frames_path.with_name("metadata.json")
+        metadata_bytes = metadata_path.read_bytes()
+        metadata = json.loads(metadata_bytes)
+        if not isinstance(metadata, dict) or metadata.get("schema_version") != 1:
+            raise ValueError("ICON demo metadata requires schema_version=1")
+        for key, expected in (
+            ("simulator_success", True),
+            ("raw_rgb", True),
+            ("split", "train"),
+            ("camera", "head"),
+        ):
+            value = metadata.get(key)
+            if value != expected or (isinstance(expected, bool) and type(value) is not bool):
+                raise ValueError(f"ICON demo provenance requires {key}={expected!r}")
+        for key in ("task_name", "task_instruction", "policy_checkpoint"):
+            if not isinstance(metadata.get(key), str) or not metadata[key].strip():
+                raise ValueError(f"ICON demo provenance requires a nonempty {key}")
+        for key in ("seed", "actual_scene_seed"):
+            if type(metadata.get(key)) is not int or metadata[key] < 0:
+                raise ValueError(f"ICON demo provenance requires a nonnegative integer {key}")
+        hasher = hashlib.sha256()
+        with frames_path.open("rb") as handle:
+            for block in iter(lambda: handle.read(1024 * 1024), b""):
+                hasher.update(block)
+        digest = hasher.hexdigest()
+        if metadata.get("frames_sha256") != digest:
+            raise ValueError("ICON demo frames_sha256 does not match frames.npy")
+        frames = np.load(frames_path, allow_pickle=False)
+        if frames.dtype != np.uint8 or frames.ndim != 4 or frames.shape[-1] != 3 or min(frames.shape) < 1:
+            raise ValueError("ICON demo frames must be nonempty uint8 RGB [T,H,W,3]")
+        if metadata.get("frame_count") != len(frames):
+            raise ValueError("ICON demo frame_count does not match frames.npy")
+        if metadata.get("first_success_frame_index") != len(frames) - 1:
+            raise ValueError("ICON demo must end at its first native simulator success")
+        indices = evenly_spaced_context_indices(len(frames), count)
+        if metadata.get("context_frames") != count or metadata.get("context_frame_indices") != indices:
+            raise ValueError("ICON demo context sampling does not match checkpoint context_frames")
+        selected = np.ascontiguousarray(frames[indices])
+        selected.setflags(write=False)
+        return cls(selected, metadata, str(frames_path), hashlib.sha256(metadata_bytes).hexdigest(), indices)
+
+    def attach(self, samples: list[Any]) -> list[dict[str, Any]]:
+        """Attach one immutable cached reference without changing query history."""
+        result = []
+        for sample in samples:
+            item = dict(sample) if isinstance(sample, dict) else sample.model_dump()
+            if item.get("context_trajectory") is not None:
+                raise ValueError("This ICON service uses its fixed demo; request context is not accepted")
+            item["context_trajectory"] = {
+                "frames": self.frames,
+                "frames_shape": self.frames.shape,
+                "task": self.metadata["task_instruction"],
+                "id": f"fixed-demo:{self.metadata['frames_sha256']}",
+                "data_source": "robotwin_train_sft",
+                "quality_label": "successful",
+                "metadata": {"context_demo_sha256": self.metadata["frames_sha256"]},
+            }
+            result.append(item)
+        return result
+
+    def info(self) -> dict[str, Any]:
+        return {
+            "frames_path": self.path,
+            "frames_sha256": self.metadata["frames_sha256"],
+            "metadata_sha256": self.metadata_sha256,
+            "task_name": self.metadata["task_name"],
+            "task_instruction": self.metadata["task_instruction"],
+            "split": self.metadata["split"],
+            "seed": self.metadata["seed"],
+            "actual_scene_seed": self.metadata["actual_scene_seed"],
+            "policy_checkpoint": self.metadata["policy_checkpoint"],
+            "camera": self.metadata["camera"],
+            "simulator_success": self.metadata["simulator_success"],
+            "source_frame_count": self.metadata["frame_count"],
+            "frame_count": len(self.frames),
+            "selected_indices": self.selected_indices,
+        }
