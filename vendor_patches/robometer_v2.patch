diff --git a/robometer/models/context_kv_cache.py b/robometer/models/context_kv_cache.py
new file mode 100644
index 0000000000000000000000000000000000000000..df76fbf486877e9e1db1d10b68547631a49ce458
--- /dev/null
+++ b/robometer/models/context_kv_cache.py
@@ -0,0 +1,356 @@
+"""Inference-only, bounded prefix caching for fixed-context Qwen3-VL rewards.
+
+The reusable prefix contains the language prompt and every context image, ending
+immediately before the first query image. Query frames are never retained between
+requests. Multimodal position IDs are computed from the original complete input;
+Qwen's generation-time position shortcut is inappropriate for new query images.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import threading
+from collections import Counter, OrderedDict
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+from transformers.cache_utils import DynamicCache
+
+
+class _UnsupportedInput(Exception):
+    pass
+
+
+def _tensor_digest(digest: Any, value: torch.Tensor) -> None:
+    value = value.detach().contiguous()
+    digest.update(str((tuple(value.shape), value.dtype)).encode())
+    digest.update(value.view(torch.uint8).cpu().numpy().tobytes())
+
+
+def _hidden_state(output: Any) -> torch.Tensor:
+    hidden = getattr(output, "last_hidden_state", None)
+    if hidden is not None:
+        return hidden
+    return output.hidden_states[-1]
+
+
+@dataclass
+class _Prefix:
+    keys_values: tuple[tuple[torch.Tensor, torch.Tensor], ...]
+    hidden: torch.Tensor
+    length: int
+    nbytes: int
+
+
+@dataclass
+class _Row:
+    active: torch.Tensor
+    ids: torch.Tensor
+    positions: torch.Tensor
+    prefix_length: int
+    context_pixels: torch.Tensor
+    context_grid: torch.Tensor
+    query_pixels: torch.Tensor
+    query_grid: torch.Tensor
+    key: str
+
+
+class FixedContextKVCache:
+    """Cache immutable per-prompt context prefixes on one inference replica.
+
+    ``forward`` returns the complete final hidden-state tensor expected by RBM's
+    existing prediction heads. Different prompts, pixels, image grids, positions,
+    model weights, devices and precision never share an entry. The GPU server's
+    replica pool already serializes use; the lock also protects direct callers.
+    """
+
+    def __init__(self, max_entries: int = 8, max_bytes: int = 512 * 1024**2):
+        if max_entries < 1 or max_bytes < 1:
+            raise ValueError("Context cache limits must be positive")
+        self.max_entries = int(max_entries)
+        self.max_bytes = int(max_bytes)
+        self._entries: OrderedDict[str, _Prefix] = OrderedDict()
+        self._bytes = 0
+        self._identity = None
+        self._stats: Counter = Counter()
+        self._fallback_reasons: Counter = Counter()
+        self._lock = threading.RLock()
+
+    def clear(self, reset_stats: bool = False) -> None:
+        with self._lock:
+            self._entries.clear()
+            self._bytes = 0
+            self._identity = None
+            if reset_stats:
+                self._stats.clear()
+                self._fallback_reasons.clear()
+
+    def info(self) -> dict[str, Any]:
+        # Health requests must not wait for a GPU inference holding the lock.
+        # Counters are diagnostic snapshots; no mutable cache tensors escape.
+        return {
+            "enabled": True,
+            "implementation": "qwen3-vl-fixed-context-kv-v1",
+            "max_entries": self.max_entries,
+            "max_bytes": self.max_bytes,
+            "entries": len(self._entries),
+            "bytes": self._bytes,
+            **{key: self._stats[key] for key in (
+                "requests", "hits", "misses", "prefill_batches", "evictions",
+                "invalidations", "fallbacks", "oversized_entries",
+            )},
+            "fallback_reasons": dict(self._fallback_reasons),
+        }
+
+    @staticmethod
+    def _model_identity(model: Any) -> tuple:
+        parameter = next(model.parameters())
+        autocast = torch.is_autocast_enabled(parameter.device.type)
+        amp_dtype = torch.get_autocast_dtype(parameter.device.type) if autocast else None
+        weights = tuple(
+            (name, weight.data_ptr(), weight._version, weight.dtype, weight.device)
+            for name, weight in model.named_parameters()
+        )
+        configuration = (
+            model.config.to_json_string(use_diff=False),
+            getattr(model.config.text_config, "_attn_implementation", None),
+            getattr(model.config.vision_config, "_attn_implementation", None),
+        )
+        return id(model), autocast, amp_dtype, configuration, weights
+
+    @staticmethod
+    def _rows(model: Any, inputs: dict[str, Any], counts: Any) -> list[_Row]:
+        ids = inputs.get("input_ids")
+        mask = inputs.get("attention_mask")
+        pixels = inputs.get("pixel_values")
+        grid = inputs.get("image_grid_thw")
+        if not isinstance(ids, torch.Tensor) or ids.ndim != 2:
+            raise _UnsupportedInput("input_ids")
+        if not isinstance(pixels, torch.Tensor) or not isinstance(grid, torch.Tensor):
+            raise _UnsupportedInput("image_inputs")
+        if grid.ndim != 2 or grid.shape[-1] != 3 or bool((grid[:, 0] != 1).any()):
+            raise _UnsupportedInput("image_grid")
+        if mask is None:
+            mask = torch.ones_like(ids)
